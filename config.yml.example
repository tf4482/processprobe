database:
  # Shared connection settings; reuse across projects if the role has required table permissions.
  host: "127.0.0.1"
  port: 5432
  name: "monitoring"
  user: "monitoring"
  password: "CHANGE_ME"

settings:
  ssh_concurrency: 4
  ssh_timeout_seconds: 5
  # Optional CIDR allowlist for literal host IPs; [] disables this restriction.
  allowed_networks: []

# Each host requires a unique name, address, OS, and non-empty process list.
hosts:
  # Documentation-only address and sample Linux process names.
  - name: "linux-server-01"
    address: "192.0.2.10"
    os: "Linux"
    ssh_user: "automation"
    ssh_port: 22
    processes: ["nginx", "postgres"]
  # Documentation-only address and sample Windows process names.
  - name: "windows-server-01"
    address: "198.51.100.10"
    os: "Windows"
    ssh_user: "automation"
    ssh_port: 22
    processes: ["spoolsv.exe", "notepad.exe"]
