database:
  # PostgreSQL connection
  host: "127.0.0.1"
  port: 5432
  name: "monitoring"
  user: "monitoring"
  password: "CHANGE_ME"

settings:
  # Parallel SSH connections and connect deadline per host
  ssh_concurrency: 4
  ssh_timeout_seconds: 5
  # CIDR allowlist for literal host IPs; [] disables the restriction
  allowed_networks: []

hosts:
  # Documentation-only addresses; ssh_user and ssh_port are optional
  - name: "linux-server-01"
    address: "192.0.2.10"
    os: "Linux"
    ssh_user: "automation"
    ssh_port: 22
    processes: ["nginx", "postgres"]
  - name: "windows-server-01"
    address: "198.51.100.10"
    os: "Windows"
    ssh_user: "automation"
    ssh_port: 22
    processes: ["spoolsv.exe", "notepad.exe"]
